# Next.js BFF (server-only; never prefix these with NEXT_PUBLIC_)
BACKEND_ORIGIN=http://localhost:8080
BFF_SHARED_SECRET=replace-with-at-least-32-random-characters
VMARKET_OPS_SECRET=replace-with-a-different-32-character-secret

# Spring Boot
# Base64-encoded 32 random bytes, backend-only. Keep stable across instances/restarts.
# Public zero-key below is LOCAL ONLY and rejected when DEPLOYMENT_ENVIRONMENT=production.
CHECKOUT_REPLAY_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Optional first operator. Supply a BCrypt hash, never a plaintext password.
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD_HASH=
# Set false only for local HTTP development; production requires true.
AUTH_SECURE_COOKIE=true
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/vmarket
SPRING_DATASOURCE_USERNAME=vmarket
SPRING_DATASOURCE_PASSWORD=local-development-password
SPRING_DATA_REDIS_URL=redis://localhost:6380
# Backend scheduler: false retains queued work without consuming it (maintenance/QA only).
IMPORT_WORKER_ENABLED=true
DEPLOYMENT_ENVIRONMENT=local
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=
SPRINGDOC_ENABLED=true

# Cloudflare deployment (used by Wrangler/GitHub Actions, not application runtime)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
