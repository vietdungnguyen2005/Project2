{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "v-market",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "vars": {
    "AI_COPILOT_ENABLED": "true",
    "AI_QA_ENABLED": "true",
    "AI_COPILOT_PANEL_ENABLED": "true",
    "AI_RUNS_ENABLED": "true",
    "AI_MAPPING_DRAFTS_ENABLED": "true",
    "AI_SERVICE_ORIGIN": "https://vmarket-ai-applied.vmarket-vietdung2005.workers.dev",
    "AI_SIGNING_KID": "cloud-20261103"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "v-market"
    }
  ],
  "observability": {
    "enabled": true
  }
}
